#!/usr/bin/env python3
"""Repository entry point for the portable plugin creator."""

from __future__ import annotations

import importlib.util
import sys
from pathlib import Path


SCRIPT = Path(__file__).resolve().parents[1] / "plugins/plugin-creator/skills/plugin-creator/scripts/create_plugin.py"
SPEC = importlib.util.spec_from_file_location("portable_plugin_creator", SCRIPT)
if SPEC is None or SPEC.loader is None:
    raise SystemExit("cannot load plugin creator")
MODULE = importlib.util.module_from_spec(SPEC)
sys.dont_write_bytecode = True
SPEC.loader.exec_module(MODULE)
raise SystemExit(MODULE.main(["create-plugin", *sys.argv[1:]]))
