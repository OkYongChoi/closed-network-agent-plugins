#!/usr/bin/env python3
"""Repository entry point for the portable plugin installer."""

from __future__ import annotations

import importlib.util
import sys
from pathlib import Path


SCRIPT = Path(__file__).resolve().parents[1] / "plugins/plugin-installer/skills/plugin-installer/scripts/plugin_installer.py"
SPEC = importlib.util.spec_from_file_location("portable_plugin_installer", SCRIPT)
if SPEC is None or SPEC.loader is None:
    raise SystemExit("cannot load plugin installer")
MODULE = importlib.util.module_from_spec(SPEC)
sys.dont_write_bytecode = True
SPEC.loader.exec_module(MODULE)
raise SystemExit(MODULE.main(sys.argv[1:]))
